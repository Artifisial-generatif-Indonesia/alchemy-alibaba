{
  "name": "alchemy-alibaba",
  "version": "0.2.0",
  "description": "Effect-native Alibaba Cloud providers for Alchemy v2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Artifisial-generatif-Indonesia/alchemy-alibaba.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.19.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./clients": {
      "types": "./dist/clients.d.ts",
      "import": "./dist/clients.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "import": "./dist/error.js"
    },
    "./ack": {
      "types": "./dist/ack/index.d.ts",
      "import": "./dist/ack/index.js"
    },
    "./acr": {
      "types": "./dist/acr/index.d.ts",
      "import": "./dist/acr/index.js"
    },
    "./rds": {
      "types": "./dist/rds/index.d.ts",
      "import": "./dist/rds/index.js"
    },
    "./tair": {
      "types": "./dist/tair/index.d.ts",
      "import": "./dist/tair/index.js"
    },
    "./vpc": {
      "types": "./dist/vpc/index.d.ts",
      "import": "./dist/vpc/index.js"
    },
    "./ecs": {
      "types": "./dist/ecs/index.d.ts",
      "import": "./dist/ecs/index.js"
    },
    "./kubernetes": {
      "types": "./dist/kubernetes/index.d.ts",
      "import": "./dist/kubernetes/index.js"
    },
    "./ram": {
      "types": "./dist/ram/index.d.ts",
      "import": "./dist/ram/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SUPPORT-MATRIX.md",
    "SPEC-COVERAGE.md",
    "LIVE-VALIDATION.md",
    "CHANGELOG.md",
    "RELEASE.md",
    "ECS.md",
    "COMPOSITION.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "check:security": "npm audit --audit-level=moderate",
    "check:package": "node scripts/prepare-release.mjs",
    "release:prepare": "npm run check && npm run check:security && npm run check:package"
  },
  "dependencies": {
    "@alicloud/cr20181201": "2.2.3",
    "@alicloud/credentials": "2.4.7",
    "@alicloud/cs20151215": "7.2.0",
    "@alicloud/ecs20140526": "7.11.2",
    "@alicloud/openapi-core": "1.0.8",
    "@alicloud/r-kvstore20150101": "6.4.0",
    "@alicloud/ram20150501": "1.3.0",
    "@alicloud/rds20140815": "15.9.0",
    "@alicloud/vpc20160428": "7.2.5",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@types/node": "22.19.7",
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.112",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "lodash": "4.18.1",
    "hono": "4.13.7",
    "@hono/node-server": "1.19.17",
    "valibot": "1.4.2"
  },
  "packageManager": "npm@11.19.1",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  }
}
